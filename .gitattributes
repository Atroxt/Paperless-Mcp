# Zeilenenden im Repository normalisieren, im Arbeitsverzeichnis plattformueblich
* text=auto

*.cs       text diff=csharp
*.csproj   text
*.slnx     text
*.props    text
*.targets  text
*.json     text
*.yml      text
*.md       text
*.config   text

# Skripte brauchen feste Zeilenenden
*.sh  text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaerdateien
*.png  binary
*.jpg  binary
*.pdf  binary
*.ico  binary
*.snk  binary

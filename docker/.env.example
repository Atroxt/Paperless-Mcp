# Kopieren nach .env (ohne .example) und anpassen. Die Kopie ist in .gitignore.
#
# Hier gehoert KEIN API-Token hinein: im HTTP-Betrieb bringt jede Anfrage ihr eigenes
# Token mit. Siehe den Kommentar oben in compose.yaml.

# Pflicht: die Paperless-Instanz, mit der gesprochen wird.
# Laeuft Paperless auf demselben Rechner, aber ausserhalb von Compose, ist
# host.docker.internal der Weg dorthin (Docker Desktop). Laeuft es in einem eigenen
# Compose-Projekt, der Service-Name in dessen Netz -- siehe compose.yaml unten.
PAPERLESS_BASE_URL=http://host.docker.internal:8000

# Port des MCP-Endpunkts, im Container wie auf dem Host.
MCP_PORT=5005

# Nur hinter einem Reverse Proxy noetig: die Adresse, unter der der Server von aussen
# erreichbar ist. Ohne diesen Wert setzt der Server die Download-Links aus der Adresse
# der Anfrage zusammen, und die zeigt dann ins interne Netz.
# MCP_PUBLIC_URL=https://mcp.example.org

# Lebensdauer eines Einmal-Links zum Herunterladen, in Sekunden.
DOWNLOAD_LINK_LIFETIME_SECONDS=300

# Obergrenze fuer Treffer je Seite bei der Dokumentsuche.
MAX_PAGE_SIZE=100

# Timeout fuer Anfragen an Paperless, in Sekunden.
HTTP_TIMEOUT_SECONDS=30

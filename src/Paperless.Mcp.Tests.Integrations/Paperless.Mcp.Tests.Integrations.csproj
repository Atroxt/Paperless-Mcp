<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Paperless.Mcp.Tests.Integrations</RootNamespace>
    <AssemblyName>Paperless.Mcp.Tests.Integrations</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Microsoft.Testing.Platform statt VSTest, passend zu global.json -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Versionen stehen zentral in Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Xeption" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperless.Mcp\Paperless.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
